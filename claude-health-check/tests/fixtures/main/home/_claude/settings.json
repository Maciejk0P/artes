{
  "model": "opus",
  "env": {
    "API_TOKEN": "FIXTURE-SECRET-VALUE-user-env"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash", "Read(./docs/**)"],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash ~/.claude/hooks/existing-hook.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/missing-hook.py --token=FIXTURE-SECRET-VALUE-hook-arg"
          }
        ]
      }
    ],
    "AfterEverything": [
      {
        "hooks": [{ "type": "command", "command": "echo done" }]
      }
    ]
  },
  "customUnknownKey": { "keep": true }
}
